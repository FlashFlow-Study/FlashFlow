{
  "name": "AssignmentCompletion",
  "type": "object",
  "properties": {
    "assignment_id": {
      "type": "string"
    },
    "student_email": {
      "type": "string",
      "minLength": 1
    },
    "user_id": {
      "type": "string"
    },
    "teacher_id": {
      "type": "string"
    },
    "classroom_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "in_progress",
        "completed"
      ],
      "default": "in_progress"
    },
    "questions_done": {
      "type": "number",
      "default": 0
    },
    "questions_correct": {
      "type": "number",
      "default": 0
    },
    "minutes_studied": {
      "type": "number",
      "default": 0
    },
    "attempts": {
      "type": "number",
      "default": 0
    },
    "started_date": {
      "type": "string",
      "format": "date-time"
    },
    "last_attempt_date": {
      "type": "string",
      "format": "date-time"
    },
    "completed_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "assignment_id",
    "student_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.student_email": "{{user.email}}"
        },
        {
          "data.teacher_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.student_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.student_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "data.teacher_id": "{{user.id}}"
    }
  }
}