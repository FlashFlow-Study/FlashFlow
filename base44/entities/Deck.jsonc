{
  "name": "Deck",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "is_public": {
      "type": "boolean",
      "default": false
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "unlisted",
        "public"
      ],
      "default": "private"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "classroom_id": {
      "type": "string"
    },
    "classroom_name": {
      "type": "string",
      "default": ""
    },
    "classroom_members": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "is_two_languages": {
      "type": "boolean",
      "default": false
    },
    "source_lang": {
      "type": "string",
      "default": ""
    },
    "target_lang": {
      "type": "string",
      "default": ""
    },
    "folder_id": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.is_public": true
        },
        {
          "data.visibility": "unlisted"
        },
        {
          "data.classroom_members": "{{user.id}}"
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}