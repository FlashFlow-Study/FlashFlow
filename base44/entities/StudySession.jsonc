{
  "name": "StudySession",
  "type": "object",
  "properties": {
    "deck_id": {
      "type": "string"
    },
    "deck_title": {
      "type": "string",
      "default": ""
    },
    "mode": {
      "type": "string",
      "enum": [
        "flashcards",
        "quiz",
        "type",
        "test",
        "grid",
        "speaking"
      ]
    },
    "cards_studied": {
      "type": "number",
      "default": 0
    },
    "score": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "deck_id",
    "mode"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}