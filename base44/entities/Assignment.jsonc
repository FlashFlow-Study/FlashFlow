{
  "name": "Assignment",
  "type": "object",
  "properties": {
    "classroom_id": {
      "type": "string"
    },
    "classroom_name": {
      "type": "string",
      "default": ""
    },
    "deck_id": {
      "type": "string"
    },
    "deck_title": {
      "type": "string",
      "default": ""
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "mode": {
      "type": "string",
      "enum": [
        "flashcards",
        "quiz",
        "type",
        "test"
      ]
    },
    "test_length": {
      "type": "number",
      "default": 0
    },
    "goal_type": {
      "type": "string",
      "enum": [
        "num_questions",
        "num_correct",
        "study_minutes"
      ]
    },
    "goal_value": {
      "type": "number",
      "default": 0
    },
    "due_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "classroom_id",
    "deck_id",
    "title",
    "mode",
    "goal_type",
    "goal_value"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}