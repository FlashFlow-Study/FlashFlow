{
  "name": "Card",
  "type": "object",
  "properties": {
    "deck_id": {
      "type": "string"
    },
    "front": {
      "type": "string",
      "minLength": 1
    },
    "back": {
      "type": "string",
      "minLength": 1
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "orientation": {
      "type": "string",
      "enum": [
        "normal",
        "swapped"
      ],
      "default": "normal"
    }
  },
  "required": [
    "deck_id",
    "front",
    "back"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}