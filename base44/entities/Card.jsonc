{
  "name": "Card",
  "type": "object",
  "properties": {
    "deck_id": {
      "type": "string"
    },
    "front": {
      "type": "string",
      "minLength": 1
    },
    "back": {
      "type": "string",
      "minLength": 1
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "orientation": {
      "type": "string",
      "enum": [
        "normal",
        "swapped"
      ],
      "default": "normal"
    },
    "deck_is_public": {
      "type": "boolean",
      "default": false
    },
    "deck_classroom_members": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "deck_id",
    "front",
    "back"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.deck_is_public": true
        },
        {
          "data.deck_classroom_members": "{{user.id}}"
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}